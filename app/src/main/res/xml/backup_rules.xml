<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude sensitive local database and authentication preferences -->
    <exclude domain="database" path="swiftcart_database"/>
    <exclude domain="database" path="swiftcart_database-journal"/>
    <exclude domain="database" path="swiftcart_database-shm"/>
    <exclude domain="database" path="swiftcart_database-wal"/>
    <exclude domain="sharedpref" path="auth_prefs.xml"/>
    <exclude domain="sharedpref" path="com.google.android.gms.signin.xml"/>
</full-backup-content>
